<%- include('../parciales/cabecera') %>
<section class="tarjeta tarjeta-formulario">
  <h1>Crear cuenta</h1>
  <%- include('../parciales/errores', { errores: Object.values(errores) }) %>
  <form action="/registro" method="post" novalidate>
    <label for="nombre">Nombre</label>
    <input id="nombre" name="nombre" type="text" value="<%= valores.nombre %>" maxlength="60" required>

    <label for="email">Correo electrónico</label>
    <input id="email" name="email" type="email" value="<%= valores.email %>" maxlength="254" required>

    <label for="password">Contraseña (mínimo 8 caracteres)</label>
    <input id="password" name="password" type="password" minlength="8" maxlength="100" required>

    <label for="password2">Repite la contraseña</label>
    <input id="password2" name="password2" type="password" minlength="8" maxlength="100" required>

    <button type="submit" class="boton boton-ancho">Registrarme</button>
  </form>
  <p class="texto-ayuda">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
</section>
<%- include('../parciales/pie') %>
