<%- include('../parciales/cabecera') %>
<p><a href="/equipos">← Volver al catálogo</a></p>
<section class="tarjeta">
  <h1><%= equipo.codigo %> · <%= equipo.nombre %></h1>
  <dl class="datos">
    <dt>Código</dt>
    <dd><%= equipo.codigo %></dd>
    <dt>Nombre</dt>
    <dd><%= equipo.nombre %></dd>
    <dt>Tipo</dt>
    <dd><%= helpers.etiquetaTipo(equipo.tipo) %></dd>
    <dt>Estado</dt>
    <dd><span class="etiqueta etiqueta-<%= equipo.estado %>"><%= helpers.etiquetaEstado(equipo.estado) %></span></dd>
  </dl>

  <% if (equipo.estado === 'operativo') { %>
    <a class="boton" href="/reservas/nueva?equipoId=<%= equipo.id %>">Reservar este equipo</a>
  <% } else { %>
    <p class="aviso aviso-error">Este equipo está fuera de servicio y no se puede reservar.</p>
  <% } %>
</section>

<section class="tarjeta">
  <h2>Turnos ya reservados</h2>
  <% if (proximasReservas.length === 0) { %>
    <p class="vacio">El equipo no tiene reservas próximas. Está libre en todos los turnos.</p>
  <% } else { %>
    <div class="tabla-contenedor">
      <table>
        <thead>
          <tr><th>Fecha</th><th>Turno</th></tr>
        </thead>
        <tbody>
          <% for (const reserva of proximasReservas) { %>
            <tr>
              <td><%= helpers.formatearFecha(reserva.fecha) %></td>
              <td><%= helpers.etiquetaTurno(reserva.turno) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('../parciales/pie') %>
